{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "Origins": ["http://localhost:4200"]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "itacr-backend",
    "Audience": "itacr-frontend",
    "Secret": "",
    "TokenLifetimeHours": 12
  },
  "LoginSecurity": {
    "MaxFailedPinAttempts": 5,
    "LockoutMinutes": 15,
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
