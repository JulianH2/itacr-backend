# Copy this file to .env and replace every "change-me" value. Never commit .env.
# Every variable must be validated at startup through @nestjs/config.

# --- Application ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins (itacr-frontend dev server)
CORS_ORIGINS=http://localhost:4200

# --- PostgreSQL (docker/docker-compose.yml) ---
POSTGRES_USER=itacr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itacr
POSTGRES_PORT=5432

# Prisma connection string; keep it in sync with the values above
DATABASE_URL=postgresql://itacr:change-me@localhost:5432/itacr?schema=public

# --- pgAdmin (optional: npm run db:tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# --- Web Push ---
# Generate with: npx web-push generate-vapid-keys  (the public key also goes to itacr-frontend)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Rate limiting (@nestjs/throttler) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
