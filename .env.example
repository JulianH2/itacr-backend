# Copy this file to .env and set your own values. Never commit .env.
# SQL Server rejects weak passwords and stops the container: use at least 8 characters
# with uppercase, lowercase, numbers, and symbols.
MSSQL_SA_PASSWORD=

# Host port for SQL Server. Change it if 1433 is already used by another SQL Server on your machine
# (then use the same port in your ConnectionStrings:Default user secret).
MSSQL_PORT=1433
